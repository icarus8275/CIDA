// Auth.js: https://authjs.dev/getting-started/adapters/prisma
// Prisma 7: client output to src/generated/prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSOR
  CIDA
}

// -------- Auth.js models (extended) ----------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  /// bcrypt hash; set only for password login
  passwordHash  String?   @map("password_hash")
  /// Plain temporary password for admin view only; cleared when user sets their own
  tempPassword  String?   @map("temp_password")
  role          UserRole  @default(PROFESSOR)

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]

  sectionInstructors SectionInstructor[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  shareMemberships   CourseShareMember[]
  shareRequestsSent  CourseShareRequest[] @relation("ShareRequester")
  shareRequestsReceived CourseShareRequest[] @relation("ShareTarget")

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "account_provider_key")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @id
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------- Academic structure ------------------------------------------------

model AcademicYear {
  id        String   @id @default(cuid())
  /// e.g. "2024–2025"
  label     String
  startYear Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms     Term[]

  @@index([startYear])
}

/// Fall / Spring / Summer or admin-defined (custom label, unique key)
model TermSeason {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms     Term[]

  @@index([sortOrder])
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  termSeasonId   String
  sortOrder      Int          @default(0)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termSeason     TermSeason   @relation(fields: [termSeasonId], references: [id], onDelete: Restrict)
  offerings      CourseOffering[]

  @@unique([academicYearId, termSeasonId])
  @@index([academicYearId])
}

// -------- Course catalog & offerings (per term) + sections ----------------

model Course {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]
  courseCodes CourseCode[]
}

model CourseCode {
  id           String     @id @default(cuid())
  courseId     String
  codeNumberId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  codeNumber   CodeNumber @relation(fields: [codeNumberId], references: [id], onDelete: Restrict)

  @@unique([courseId, codeNumberId])
  @@index([codeNumberId])
}

model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  termId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  sections Section[]
  shareGroups   CourseShareGroup[]
  shareRequests CourseShareRequest[]

  @@unique([courseId, termId])
  @@index([termId])
}

model Section {
  id               String   @id @default(cuid())
  courseOfferingId String
  /// e.g. "001", "A"
  label            String
  sortOrder        Int      @default(0)
  /// Pasted OneDrive (or any) share URL for the section syllabus
  syllabusUrl      String?  @map("syllabus_url")
  syllabusLinkTitle String? @map("syllabus_link_title")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courseOffering CourseOffering      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  courseItems    CourseItem[]
  instructors    SectionInstructor[]
  poolForShares  CourseShareGroup[]

  @@index([courseOfferingId])
}

model SectionInstructor {
  userId    String
  sectionId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

// -------- Item types & per-section items (assignments, etc.) ----------------

model ItemTypeDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseItems CourseItem[]
}

/// Admin-managed catalog. Faculty assign one or more to each assignment/quiz/exam/project.
model CodeNumber {
  id        String   @id @default(cuid())
  /// e.g. "6A" — unique, stored uppercase
  value     String   @unique
  label     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemLinks CourseItemCode[]
  courseLinks CourseCode[]
}

model CourseItem {
  id         String   @id @default(cuid())
  sectionId  String
  itemTypeId String
  number     Int
  /// Optional custom title; if null, UI can show type + number
  title      String?
  sortOrder  Int      @default(0)
  /// Pasted OneDrive (or any) share URL
  oneDriveUrl String?  @map("one_drive_url")
  linkTitle  String?  @map("link_title")
  /// When true, Explore shows "On Site Display" instead of a file link
  onSiteDisplay Boolean @default(false) @map("on_site_display")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section  Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  itemType ItemTypeDefinition  @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  codes    CourseItemCode[]

  @@unique([sectionId, itemTypeId, number])
  @@index([sectionId])
}

model CourseItemCode {
  id            String   @id @default(cuid())
  courseItemId  String
  codeNumberId  String
  courseItem    CourseItem @relation(fields: [courseItemId], references: [id], onDelete: Cascade)
  codeNumber    CodeNumber @relation(fields: [codeNumberId], references: [id], onDelete: Restrict)

  @@unique([courseItemId, codeNumberId])
  @@index([codeNumberId])
}

// -------- Backups, activity logs, notifications, section sharing ----------

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

/// JSON snapshot of academic data (terms, courses, faculty, items). Kept ~7 days.
model DataBackup {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  trigger   BackupTrigger
  itemCount Int           @default(0)
  payload   Json

  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  actorEmail String?
  summaryEn  String
  summaryKo  String
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}

enum NotificationKind {
  SHARE_REQUEST
  SHARE_ACCEPTED
  SHARE_DECLINED
  SHARE_ENDED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  titleEn   String
  titleKo   String
  bodyEn    String
  bodyKo    String
  href      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ShareRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model CourseShareGroup {
  id               String   @id @default(cuid())
  courseOfferingId String
  poolSectionId    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courseOffering CourseOffering      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  poolSection    Section             @relation(fields: [poolSectionId], references: [id], onDelete: Restrict)
  members        CourseShareMember[]
  requests       CourseShareRequest[]

  @@index([courseOfferingId])
  @@index([poolSectionId])
}

model CourseShareMember {
  shareGroupId String
  userId       String
  joinedAt     DateTime @default(now())
  shareGroup   CourseShareGroup @relation(fields: [shareGroupId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shareGroupId, userId])
  @@index([userId])
}

model CourseShareRequest {
  id               String             @id @default(cuid())
  courseOfferingId String
  shareGroupId     String?
  requesterUserId  String
  targetUserId     String
  status           ShareRequestStatus @default(PENDING)
  createdAt        DateTime           @default(now())
  respondedAt      DateTime?

  courseOffering CourseOffering    @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  shareGroup     CourseShareGroup? @relation(fields: [shareGroupId], references: [id], onDelete: SetNull)
  requester      User              @relation("ShareRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  target         User              @relation("ShareTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([courseOfferingId])
  @@index([targetUserId, status])
  @@index([requesterUserId])
}
